{
  "name": "run-mux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "dev": "bun src/cli/index.ts",
    "test": "bun test --timeout 20000",
    "test:watch": "bun test --watch --timeout 20000",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt src test scripts",
    "fmt:check": "oxfmt --check src test scripts",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "@opentui/core": "0.5.3",
    "@opentui/react": "0.5.3",
    "react": "19.2.0",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.6.0",
    "@types/react": "19.2.2",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "typescript": "6.0.2"
  }
}
